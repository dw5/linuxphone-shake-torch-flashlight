# ~/.config/shake-torch.conf. After a change: systemctl --user reload shake-torch
[shake-torch]
# false: keep running but don't switch the torch
enabled=true
# How hard the strongest swing must be, in g with gravity taken out; the swing back must
# reach 60% of it. Lower is easier to trigger. Walking peaks at about 1.25.
threshold=1.4
# At least this long between two switches (it also waits for the phone to be calm).
cooldown-ms=800
# Keep the accelerometer on while the screen is off (sensorfwd's standby override).
# FuriOS doesn't pause it anyway; Sailfish does. Costs battery; see README.md.
screen-off=true
# Vibrate when the torch switches, also in the silent profile: torch on is two buzzes
# with a pause between, torch off is one. Lengths in ms.
vibrate=true
buzz-on-ms=250
# The second "on" buzz; 0 or left out: as long as the first.
buzz-second-ms=0
buzz-gap-ms=50
buzz-off-ms=275
# Log every movement over 0.4 g to the journal, for tuning.
log-movement=false
