#!/usr/bin/python3
"""Settings for shake-torch on FuriOS: on or off, how hard to shake, and the buzzes,
with buttons to feel them before keeping them. Changes are saved at once to
~/.config/shake-torch.conf and the service is told to reread it."""
import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

CONFIG = Path(GLib.get_user_config_dir()) / "shake-torch.conf"
GROUP = "shake-torch"
VIBRATOR = Path("/sys/class/leds/vibrator")
# Same defaults as the service.
# Motorola's buzz: on is 200 ms, 100 ms pause, 400 ms; off is 300 ms.
DEFAULTS = {"enabled": True, "threshold": 1.4, "max-rotation": 108.0, "notify": True,
            "vibrate": True, "buzz-on-ms": 200, "buzz-second-ms": 400, "buzz-gap-ms": 100,
            "buzz-off-ms": 300}


def buzz(ms):
    for name, value in (("duration", str(int(ms))), ("activate", "1")):
        try:
            with open(VIBRATOR / name, "w") as f:
                f.write(value)
        except OSError:
            return False
    return True


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Shake Torch", default_width=360, default_height=640)
        self.keyfile = GLib.KeyFile()
        try:
            self.keyfile.load_from_file(str(CONFIG), GLib.KeyFileFlags.KEEP_COMMENTS)
        except GLib.Error:
            pass
        self.save_id = 0
        self.timers = []

        self.enabled = Adw.SwitchRow(title="Shake to switch the torch", active=self.get("enabled"))
        self.enabled.connect("notify::active", self.changed)
        self.status = Adw.ActionRow(title="Service", subtitle="Checking…")
        main = Adw.PreferencesGroup(
            description="Shake the phone firmly for about half a second. Works with the screen off too.")
        self.notify = Adw.SwitchRow(title="Notification while it's on",
                                    subtitle="\u201cFlashlight is on\u201d, tap to turn it off",
                                    active=self.get("notify"))
        self.notify.connect("notify::active", self.changed)
        main.add(self.enabled)
        main.add(self.notify)
        main.add(self.status)

        self.threshold = self.slider(0.8, 4.0, 0.1, self.get("threshold"), 1)
        hard = Adw.PreferencesGroup(
            title="How hard to shake",
            description="A shake is a swing one way and back, like a chop. Left: a gentle "
                        "one is enough, but walking may set it off. Right: needs a firmer one. "
                        "Measured on this phone: walking up to 1.25 g, gentle shakes 1.5 to 2 g, "
                        "normal ones 4 to 10 g.")
        hard.add(self.slider_row("Strength", self.threshold, "{:.2f} g"))
        self.rotation = self.slider(0, 360, 10, self.get("max-rotation"), 0)
        twist = Adw.PreferencesGroup(
            title="Ignore twists",
            description="Like Motorola: a chop moves the phone along a line, a flick of the wrist "
                        "turns it. A shake that turns the phone more than this doesn't count. "
                        "Motorola uses 108\u00b0. Measured on this phone: shakes 25 to 108\u00b0, "
                        "twists 110 to 220\u00b0. 0: no check.")
        twist.add(self.slider_row("Most it may turn", self.rotation, "{:.0f}\u00b0"))

        self.vibrate = Adw.SwitchRow(title="Vibrate", subtitle="Also when the phone is set to silent",
                                     active=self.get("vibrate"))
        self.vibrate.connect("notify::active", self.changed)
        self.on_ms = self.slider(10, 500, 10, self.get("buzz-on-ms"), 0)
        # 0 in the file means "as long as the first".
        self.second_ms = self.slider(10, 500, 10, self.get("buzz-second-ms") or self.get("buzz-on-ms"), 0)
        self.gap_ms = self.slider(50, 800, 10, self.get("buzz-gap-ms"), 0)
        self.off_ms = self.slider(10, 1000, 10, self.get("buzz-off-ms"), 0)
        try_on = Gtk.Button(label="Try torch on", hexpand=True)
        try_on.connect("clicked", lambda *_: self.try_buzz(True))
        try_off = Gtk.Button(label="Try torch off", hexpand=True)
        try_off.connect("clicked", lambda *_: self.try_buzz(False))
        for b in (try_on, try_off):
            b.add_css_class("pill")
        buttons = Gtk.Box(spacing=12, margin_top=12, homogeneous=True)
        buttons.append(try_on)
        buttons.append(try_off)
        vib = Adw.PreferencesGroup(title="Vibration",
                                   description="Torch on: two buzzes with a pause. Torch off: one buzz.")
        for r in (self.vibrate,
                  self.slider_row("Torch on, first buzz", self.on_ms, "{:.0f} ms"),
                  self.slider_row("Torch on, second buzz", self.second_ms, "{:.0f} ms"),
                  self.slider_row("Torch on, pause between", self.gap_ms, "{:.0f} ms"),
                  self.slider_row("Torch off, buzz", self.off_ms, "{:.0f} ms")):
            vib.add(r)
        vib.add(buttons)
        if not os.access(VIBRATOR / "activate", os.W_OK):
            for b in (try_on, try_off):
                b.set_sensitive(False)
            vib.set_description(vib.get_description() + " (No vibrator found to try them on.)")

        page = Adw.PreferencesPage()
        for g in (main, hard, twist, vib):
            page.add(g)
        view = Adw.ToolbarView(content=page)
        view.add_top_bar(Adw.HeaderBar())
        self.set_content(view)
        self.refresh_status()
        GLib.timeout_add_seconds(3, self.refresh_status)
        self.connect("close-request", self.on_close)

    def get(self, key):
        default = DEFAULTS[key]
        try:
            if isinstance(default, bool):
                return self.keyfile.get_boolean(GROUP, key)
            if isinstance(default, float):
                return self.keyfile.get_double(GROUP, key)
            return self.keyfile.get_integer(GROUP, key)
        except GLib.Error:
            return default

    def slider(self, lo, hi, step, value, digits):
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_value(value)
        s.set_digits(digits)
        s.set_round_digits(digits)
        # Snap to the step, so a drag gives 250 rather than 249.
        s.connect("change-value", lambda sc, _scroll, v: (sc.set_value(round(v / step) * step), True)[1])
        s.set_hexpand(True)
        s.set_draw_value(False)
        s.connect("value-changed", self.changed)
        return s

    def slider_row(self, title, scale, fmt):
        label = Gtk.Label(width_chars=7, xalign=1)
        label.add_css_class("numeric")
        update = lambda *_: label.set_label(fmt.format(scale.get_value()))
        scale.connect("value-changed", update)
        update()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_start=12, margin_end=12,
                      margin_top=8, margin_bottom=8)
        head = Gtk.Box()
        head.append(Gtk.Label(label=title, xalign=0, hexpand=True))
        head.append(label)
        box.append(head)
        box.append(scale)
        return Adw.PreferencesRow(activatable=False, child=box)

    def try_buzz(self, on):
        for t in self.timers:
            GLib.source_remove(t)
        self.timers = []
        if on:
            length = self.on_ms.get_value()
            second_length = self.second_ms.get_value()
            buzz(length)

            def second():
                self.timers = []
                buzz(second_length)
                return GLib.SOURCE_REMOVE
            self.timers.append(GLib.timeout_add(int(length + self.gap_ms.get_value()), second))
        else:
            buzz(self.off_ms.get_value())

    def changed(self, *_):
        # Save shortly after the last change, not on every step of a drag.
        if self.save_id:
            GLib.source_remove(self.save_id)
        self.save_id = GLib.timeout_add(400, self.save)

    def save(self):
        self.save_id = 0
        kf = self.keyfile
        kf.set_boolean(GROUP, "enabled", self.enabled.get_active())
        kf.set_double(GROUP, "threshold", round(self.threshold.get_value(), 1))
        kf.set_double(GROUP, "max-rotation", round(self.rotation.get_value()))
        kf.set_boolean(GROUP, "notify", self.notify.get_active())
        kf.set_boolean(GROUP, "vibrate", self.vibrate.get_active())
        kf.set_integer(GROUP, "buzz-on-ms", int(self.on_ms.get_value()))
        kf.set_integer(GROUP, "buzz-second-ms", int(self.second_ms.get_value()))
        kf.set_integer(GROUP, "buzz-gap-ms", int(self.gap_ms.get_value()))
        kf.set_integer(GROUP, "buzz-off-ms", int(self.off_ms.get_value()))
        try:
            CONFIG.parent.mkdir(parents=True, exist_ok=True)
            kf.save_to_file(str(CONFIG))
        except (GLib.Error, OSError) as e:
            self.status.set_subtitle(f"Couldn't save: {e}")
            return GLib.SOURCE_REMOVE
        try:
            Gio.Subprocess.new(["systemctl", "--user", "reload", "shake-torch.service"],
                               Gio.SubprocessFlags.STDERR_SILENCE)
        except GLib.Error:
            pass
        return GLib.SOURCE_REMOVE

    def refresh_status(self):
        try:
            state = subprocess.run(["systemctl", "--user", "is-active", "shake-torch.service"],
                                   capture_output=True, text=True, timeout=2).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            state = "unknown"
        self.status.set_subtitle({"active": "Running", "inactive": "Not running",
                                  "failed": "Failed; see its log"}.get(state, state or "unknown"))
        return GLib.SOURCE_CONTINUE

    def on_close(self, *_):
        if self.save_id:
            GLib.source_remove(self.save_id)
            self.save()
        return False


class App(Adw.Application):
    def __init__(self):
        # Not local.ShakeTorch: that's the service's own D-Bus name.
        super().__init__(application_id="local.ShakeTorch.Settings")

    def do_activate(self):
        (self.props.active_window or Window(self)).present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
