[Desktop Entry]
Type=Application
Name=Shake Torch
Comment=Shake the phone to switch the torch
Icon=shake-torch
Exec=invoker --type=silica-qt5 -s /usr/bin/sailfish-qml shake-torch
X-Nemo-Application-Type=silica-qt5

[X-Sailjail]
# Talks to its own service and to systemd on the session bus.
Sandboxing=Disabled
